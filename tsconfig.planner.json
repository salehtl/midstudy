{
  // The planner (browser): bundled by esbuild (scripts/build.mjs). `.js` import specifiers resolve to the `.ts` file;
  // the planner is TypeScript only. planner/gpu/ (the WebGPU spike) is part of this area. core/js/web.ts (the kernels'
  // face, its own core-web area) is listed too: the planner imports it, and a composite project must list every file it
  // compiles (a project reference would need core-web to emit declarations, and every area is noEmit).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [],
    "tsBuildInfoFile": "build/tsc/planner.tsbuildinfo"
  },
  "include": ["planner/**/*.ts", "core/js/web.ts", "contract/gen/types.ts"],
  "exclude": ["planner/dist"]
}
