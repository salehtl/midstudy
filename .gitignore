# Root files without an extension (Apple Photos exports such as AD9729E1-…_1_201_a, camera originals with GPS) are
# never committed: ignore every root entry, then re-include names with a dot and folders. These lines come first so
# that every rule below (.env, .upstream/, node_modules/, the image extensions) still wins over the re-includes.
/*
!/*.*
!/*/

.DS_Store
.direnv/
.venv/
__pycache__/
node_modules/
*.log
result
result-*
build/
target/

# v2 build outputs (scripts/build.mjs): the planner bundle (no trailing slash: also a symlink), wasm, stamps, locks;
# TScert's report is regenerated by every check:tscert run (the baseline is tracked)
/planner/dist
/build/
tscert/report.json
tscert/experiments/report.json

# secrets: the real FAL key lives here
.env

# nook's source, for reference only (cloned by the foundation agent)
.upstream/

# the user's own room photos (location data in private/): never commit
fixtures/photos/
# camera originals dropped at the repo root by hand: never commit (the extensions are below)
/*.jpg
/*.jpeg
/*.JPG
/*.JPEG
/*.heic
/*.HEIC
/*.png
/*.PNG
/*.webp
/*.WEBP
/*.heif
/*.HEIF
/*.tif
/*.tiff
/*.TIF
/*.TIFF
/*.dng
/*.DNG
/*.avif
/*.AVIF

# eval scratch output
evals/out/

# user data written by the tools; decisions (library.json, costs.csv) are versioned. Anchored with `/` (git anchors a
# pattern with a slash anyway; knip, which reads this file, would otherwise skip server/src/library/ and friends). The
# v2 locks are folders: <library>/.lock.d and costs.csv.lock.d (contract §2.8 One writer)
/library/*/
/library/_inbox/
/library/.lock
/library/.lock.d/
/library/.trash/
/library/costs.csv.lock
library/settings.json
/library/costs.csv.lock.d/
/scenes/
/layouts/
/renders/
/rooms/

# product pages downloaded for the golden set (shops' pages and pictures are never committed)
fixtures/pages/
