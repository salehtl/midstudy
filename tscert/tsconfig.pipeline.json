{
  // What TScert reads pipeline/src/logic/ with: the pipeline's strict options, the logic modules only (and common/logic/,
  // which they share with the server), no Node types.
  "extends": "../tsconfig.pipeline.json",
  "compilerOptions": { "lib": ["ES2024"], "types": [], "composite": false },
  "include": ["../pipeline/src/logic/**/*.ts", "../common/logic/**/*.ts"]
}
