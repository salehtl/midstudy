{
  // midstudy-add on Node 22, run directly (`node pipeline/src/cli.ts`, type stripping): `.ts` import specifiers. Its
  // wasm face (core/js/pipeline.ts) is checked here; core/js/node.ts (the media kernels) is core-node's, listed here
  // too because a composite project must list every file it imports. ESNext.Float16 only types glTF-Transform's
  // TypedArray union (Float16Array is in it); nothing here uses a Float16Array.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Float16"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "tsBuildInfoFile": "build/tsc/pipeline.tsbuildinfo"
  },
  "include": ["pipeline/**/*.ts", "core/js/pipeline.ts", "core/js/node.ts"]
}
