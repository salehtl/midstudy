{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "planner/main.{ts,js}",
    "planner/**/*.worker.{ts,js}",
    "server/src/main.ts",
    "server/test/*.test.ts",
    "server/test/lock-child.ts",
    "server/test/scenes/*.test.ts",
    "server/test/scenes/fake-calib.ts",
    "pipeline/src/cli.ts",
    "pipeline/test/*.test.ts",
    "core/js/{web,node}.ts",
    "core/js/**/*.worker.ts",
    "scripts/*.mjs",
    "evals/*.mjs",
    "evals/lib/*.mjs",
    "fixtures/*.mjs"
  ],
  "project": [
    "planner/**/*.{ts,js}",
    "server/**/*.ts",
    "common/**/*.ts",
    "pipeline/**/*.ts",
    "core/js/**/*.ts",
    "contract/gen/**/*.{ts,js}",
    "scripts/**/*.mjs",
    "evals/**/*.mjs",
    "fixtures/**/*.mjs"
  ],
  "ignore": [
    "planner/dist/**",
    "planner/**/*.js",
    "contract/gen/**"
  ],
  "ignoreDependencies": [
    "libheif-js",
    "obj2gltf"
  ],
  "ignoreBinaries": [
    "nix",
    "tscert",
    "cargo",
    "lake",
    "pyright",
    "ruff",
    "uv",
    "wasm-bindgen",
    "wasm-opt"
  ]
}
