{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "planner/main.ts",
    "planner/**/*.worker.ts",
    "server/src/main.ts",
    "pipeline/src/cli.ts",
    "core/js/{web,node}.ts",
    "core/js/**/*.worker.ts",
    "scripts/*.mjs",
    "evals/*.mjs",
    "evals/lib/*.mjs",
    "fixtures/*.mjs"
  ],
  "project": [
    "planner/**/*.ts",
    "server/**/*.ts",
    "pipeline/**/*.ts",
    "core/js/**/*.ts",
    "contract/gen/**/*.{ts,js}",
    "scripts/**/*.mjs",
    "evals/**/*.mjs",
    "fixtures/**/*.mjs"
  ],
  "ignore": [
    "planner/dist/**",
    "contract/gen/**"
  ],
  "ignoreDependencies": [
    "@gltf-transform/core",
    "@gltf-transform/extensions",
    "@gltf-transform/functions",
    "fflate",
    "libheif-js",
    "obj2gltf",
    "parse5"
  ],
  "ignoreBinaries": [
    "nix",
    "tscert",
    "cargo",
    "lake",
    "pyright",
    "ruff",
    "uv",
    "wasm-bindgen",
    "wasm-opt"
  ]
}
