{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "midstudy/calib-cli.schema.json",
  "title": "midstudy-calib's results and its worker protocol (contract §4.3)",
  "description": "The last stdout line of every one-shot command, and the JSON lines of `midstudy-calib serve` (contract §4.3 Worker). A worker response is the one-shot result of its command plus the request's `id`; one-shot results carry no `id`. Written by calib (calib/src/midstudy_calib/schemas/); calib.schema.json and lighting.schema.json are copies of contract/.",
  "$defs": {
    "id": {
      "description": "Worker responses only: the request's id (null when the request had no usable id).",
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "description": "Any command that failed: exit 1 (one-shot), the same sentence as the last stderr line after `midstudy-calib: `.",
      "type": "object",
      "required": [
        "ok",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "ok": {
          "const": false
        },
        "error": {
          "description": "One sentence the server shows as it is.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run": {
      "description": "`run` and `fit`: calib.json's contents plus \"ok\": true.",
      "allOf": [
        {
          "$ref": "calib.schema.json"
        },
        {
          "required": [
            "ok"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "id": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "ingest": {
      "type": "object",
      "required": [
        "ok",
        "photo",
        "source",
        "image"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "ok": {
          "const": true
        },
        "photo": {
          "const": "photo.jpg"
        },
        "source": {
          "enum": [
            "source.jpg",
            "source.png",
            "source.heic",
            "source.webp"
          ]
        },
        "image": {
          "$ref": "calib.schema.json#/$defs/size"
        }
      }
    },
    "light_done": {
      "description": "`light` wrote lighting.json.",
      "type": "object",
      "required": [
        "ok",
        "lighting",
        "cct_k",
        "confidence",
        "elapsed_s"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "ok": {
          "const": true
        },
        "lighting": {
          "const": true
        },
        "cct_k": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1000,
          "maximum": 40000
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "elapsed_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "light_none": {
      "description": "`light` found too little to go on and wrote nothing.",
      "type": "object",
      "required": [
        "ok",
        "lighting",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "ok": {
          "const": true
        },
        "lighting": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "light": {
      "oneOf": [
        {
          "$ref": "#/$defs/light_done"
        },
        {
          "$ref": "#/$defs/light_none"
        }
      ]
    },
    "align": {
      "type": "object",
      "required": [
        "ok",
        "applied",
        "inliers",
        "residual_px"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "ok": {
          "const": true
        },
        "applied": {
          "type": "boolean"
        },
        "inliers": {
          "type": "integer",
          "minimum": 0
        },
        "residual_px": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "reason": {
          "description": "Why it wasn't applied.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "request": {
      "description": "One line on the worker's stdin.",
      "type": "object",
      "required": [
        "id",
        "cmd",
        "args"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Echoed in the response.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cmd": {
          "enum": [
            "run",
            "fit",
            "light",
            "align",
            "ingest"
          ]
        },
        "args": {
          "description": "The one-shot command's arguments after its name, as an argument list.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        }
      }
    }
  }
}
