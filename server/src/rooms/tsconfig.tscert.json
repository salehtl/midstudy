{
  // What TScert reads the rooms logic with (server/src/rooms/logic/), until tscert/config.json and
  // tscert/tsconfig.server.json (toolchain's) gain the area; the same options as tscert/tsconfig.server.json. Run:
  // node scripts/tscert-ratchet.mjs --project server/src/rooms/tsconfig.tscert.json \
  //   --files server/src/rooms/logic/<a>.ts,...,common/logic/pyfmt.ts,server/src/scenes/logic/values.ts
  // (one file of each logic folder it imports, so the sandbox copies those folders too).
  "extends": "../../../tsconfig.server.json",
  "compilerOptions": { "lib": ["ES2024"], "types": [], "composite": false },
  "include": [
    "./logic/**/*.ts",
    "../scenes/logic/**/*.ts",
    "../logic/**/*.ts",
    "../../../common/logic/**/*.ts"
  ]
}
