{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "midstudy/api/spend.schema.json",
  "title": "Spend",
  "description": "GET /api/spend (contract §2.9): today's (UTC) spend from costs.csv, what running calls have reserved, and the cap.",
  "type": "object",
  "required": ["day", "spent_usd", "reserved_usd", "cap_usd"],
  "additionalProperties": false,
  "properties": {
    "day": { "description": "The UTC day, YYYY-MM-DD.", "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "spent_usd": { "$ref": "common.schema.json#/$defs/usd" },
    "reserved_usd": { "$ref": "common.schema.json#/$defs/usd" },
    "cap_usd": { "$ref": "common.schema.json#/$defs/usd" }
  }
}
