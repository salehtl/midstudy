{
  "$comment": "Every /api route of contract/CONTRACT.md and the schema of each JSON payload, by schema URI (contract/api/README.md). A request matches the first route whose method and path template fit ({param} is one path segment). A response's schema is responses[<status>], else responses[<1st digit>xx], else errors for any status >= 400; a success status that isn't listed is itself a contract violation. request.body is a schema URI, or \"raw\" for a raw upload whose X-Midstudy-Meta header (base64 JSON) has its own schema.",
  "errors": "midstudy/api/error.schema.json",
  "routes": [
    { "method": "GET", "path": "/api/spend", "contract": "§2.9", "responses": { "200": "midstudy/api/spend.schema.json" } },
    { "method": "POST", "path": "/api/render", "contract": "§2.6, §4.7", "request": { "body": "midstudy/api/render-request.schema.json" }, "responses": { "200": "midstudy/api/render-meta.schema.json", "402": "midstudy/api/spend-refused.schema.json" } },
    { "method": "GET", "path": "/api/renders", "contract": "§2.6, §4.7", "query": ["scene"], "responses": { "200": "midstudy/api/render-list.schema.json" } },

    { "method": "GET", "path": "/api/layouts", "contract": "§2.7", "query": ["scene"], "responses": { "200": "midstudy/api/layout-list.schema.json" } },
    { "method": "GET", "path": "/api/layouts/{layout}", "contract": "§2.7", "query": ["scene"], "responses": { "200": "midstudy/layout.schema.json" } },
    { "method": "PUT", "path": "/api/layouts/{layout}", "contract": "§2.7", "query": ["scene"], "request": { "body": "midstudy/api/layout-put.schema.json" }, "responses": { "200": "midstudy/layout.schema.json" } },
    { "method": "DELETE", "path": "/api/layouts/{layout}", "contract": "§2.7", "query": ["scene"], "responses": { "200": "midstudy/api/layout-deleted.schema.json" } },

    { "method": "GET", "path": "/api/library", "contract": "§2.8", "responses": { "200": "midstudy/api/library-get.schema.json" } },
    { "method": "POST", "path": "/api/library/items", "contract": "§2.8", "request": { "body": "raw", "headers": { "X-Midstudy-Meta": "midstudy/api/library-meta.schema.json" } }, "responses": { "202": "midstudy/api/library-add-accepted.schema.json", "402": "midstudy/api/spend-refused.schema.json" } },
    { "method": "POST", "path": "/api/library/items/from-url", "contract": "§2.8, §2.9", "request": { "body": "midstudy/api/library-from-url.schema.json" }, "responses": { "202": "midstudy/api/library-add-accepted.schema.json", "402": "midstudy/api/spend-refused.schema.json" } },
    { "method": "POST", "path": "/api/library/product", "contract": "§2.11", "request": { "body": "midstudy/api/product-request.schema.json" }, "responses": { "200": "midstudy/api/product-result.schema.json", "4xx": "midstudy/api/product-error.schema.json" } },
    { "method": "GET", "path": "/api/library/jobs", "contract": "§2.8", "responses": { "200": "midstudy/api/library-jobs.schema.json" } },
    { "method": "GET", "path": "/api/library/jobs/{id}", "contract": "§2.8", "responses": { "200": "midstudy/api/library-job.schema.json" } },
    { "method": "PATCH", "path": "/api/library/items/{id}", "contract": "§2.8", "request": { "body": "midstudy/api/library-patch.schema.json" }, "responses": { "200": "midstudy/library.schema.json#/$defs/item", "202": "midstudy/api/library-rescale-accepted.schema.json" } },
    { "method": "DELETE", "path": "/api/library/items/{id}", "contract": "§2.8", "responses": { "200": "midstudy/api/library-deleted.schema.json" } },
    { "method": "POST", "path": "/api/library/items/{id}/restore", "contract": "§2.8", "responses": { "200": "midstudy/library.schema.json#/$defs/item" } },
    { "method": "PUT", "path": "/api/library/items/{id}/thumb", "contract": "§2.8", "request": { "body": "midstudy/api/thumb-put.schema.json" }, "responses": { "200": "midstudy/library.schema.json#/$defs/item" } },

    { "method": "GET", "path": "/api/scenes", "contract": "§4.4", "responses": { "200": "midstudy/api/scene-list.schema.json" } },
    { "method": "POST", "path": "/api/scenes", "contract": "§4.4", "request": { "body": "raw", "headers": { "X-Midstudy-Meta": "midstudy/api/scene-meta.schema.json" } }, "responses": { "202": "midstudy/api/scene-created.schema.json" } },
    { "method": "GET", "path": "/api/scenes/jobs", "contract": "§4.4", "responses": { "200": "midstudy/api/scene-jobs.schema.json" } },
    { "method": "GET", "path": "/api/scenes/jobs/{id}", "contract": "§4.4", "responses": { "200": "midstudy/api/scene-job.schema.json" } },
    { "method": "GET", "path": "/api/scenes/{name}", "contract": "§4.4, §4.8", "responses": { "200": "midstudy/api/scene-detail.schema.json" } },
    { "method": "PUT", "path": "/api/scenes/{name}", "contract": "§4.4, §4.8", "request": { "body": "midstudy/api/scene-put.schema.json" }, "responses": { "200": "midstudy/api/scene-detail.schema.json" } },
    { "method": "DELETE", "path": "/api/scenes/{name}", "contract": "§4.4", "responses": { "200": "midstudy/api/scene-deleted.schema.json" } },
    { "method": "PUT", "path": "/api/scenes/{name}/thumb", "contract": "§4.4", "request": { "body": "midstudy/api/thumb-put.schema.json" }, "responses": { "200": "midstudy/api/scene-thumb-saved.schema.json" } },
    { "method": "POST", "path": "/api/scenes/{name}/calibrate", "contract": "§4.4", "responses": { "202": "midstudy/api/calibrate-accepted.schema.json" } },
    { "method": "POST", "path": "/api/scenes/{name}/light", "contract": "§4.4, §4.8", "responses": { "202": "midstudy/api/light-accepted.schema.json", "200": "midstudy/api/light-done.schema.json" } },
    { "method": "POST", "path": "/api/scenes/{name}/restore", "contract": "§4.4", "responses": { "200": "midstudy/api/scene-object.schema.json" } }
  ]
}
