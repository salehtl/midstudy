{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "midstudy/api/scene-thumb-saved.schema.json",
  "title": "SceneThumbSaved",
  "description": "200 of PUT /api/scenes/<name>/thumb (contract §4.4): thumb.jpg written without metadata.",
  "type": "object",
  "required": ["ok", "thumb_url"],
  "additionalProperties": false,
  "properties": {
    "ok": { "const": true },
    "thumb_url": { "type": "string", "pattern": "^/scenes/[a-z0-9][a-z0-9-]{0,63}/thumb\\.jpg(\\?v=\\d+)?$" }
  }
}
