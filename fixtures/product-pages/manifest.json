    },
    {
      "path": "/wp-json/wc/store/v1/products",
      "query": {
        "slug": "wool-carpet-sand"
      },
      "file": "pages/woo-rug-cm.json",
      "type": "application/json; charset=utf-8"
    },
    {
      "path": "/products/lan-chair",
      "file": "pages/private-pictures.html"
    },
    {
      "path": "/products/deep-feed-stool",
      "file": "pages/deep-feed.html"
    },
    {
      "path": "/products/deep-feed-stool.js",
      "generate": "deep",
      "note": "a feed nested 200,000 levels deep"
    },
    {
      "path": "/products/digits-chair",
      "generate": "digits",
      "note": "a 12,000-digit run and 20,000 escaped quotes: CPU work, never a frozen server"
    },
    {
      "path": "/no-product",
      "file": "pages/no-product.html"
    },
    {
      "path": "/blocked",
      "status": 403,
      "file": "pages/blocked.html"
    },
    {
      "path": "/busy",
      "status": 429,
      "file": "pages/blocked.html",
      "headers": {
        "Retry-After": "60"
      }
    },
    {
      "path": "/unavailable",
      "status": 503,
      "body": "<html><body>Service Unavailable</body></html>"
    },
    {
      "path": "/robot-check",
      "file": "pages/captcha.html"
    },
    {
      "path": "/missing",
      "status": 404,
      "body": "<html><body>Not found</body></html>"
    },
    {
      "path": "/picture.jpg",
      "generate": "jpeg",
      "type": "image/jpeg"
    },
    {
      "path": "/manual.pdf",
      "body": "%PDF-1.4 not really",
      "type": "application/pdf"
    },
    {
      "path": "/redirect-ok",
      "status": 302,
      "location": "/products/oak-writing-desk"
    },
    {
      "path": "/redirect-private",
      "status": 302,
      "location": "http://10.1.2.3/products/oak-writing-desk"
    },
    {
      "path": "/redirect-metadata",
      "status": 301,
      "location": "http://169.254.169.254/latest/meta-data/"
    },
    {
      "path": "/hops/{n}",
      "generate": "hops",
      "note": "302 to /hops/{n-1}; /hops/0 is the desk page. /hops/5 is allowed (5 redirects), /hops/6 is not."
    },
    {
      "path": "/slow",
      "generate": "slow",
      "note": "headers after 25 s"
    },
    {
      "path": "/trickle",
      "generate": "trickle",
      "note": "a valid start, then one byte a second for 60 s"
    },
    {
      "path": "/huge",
      "generate": "huge",
      "note": "the desk's JSON-LD, then 12 MB of filler"
    },
    {
      "path": "/gzip",
      "generate": "gzip",
      "note": "the desk page, Content-Encoding: gzip"
    },
    {
      "path": "/gzip-bomb",
      "generate": "gzip-bomb",
      "note": "the desk's JSON-LD, then 200 MB of spaces, gzipped (about 200 KB on the wire)"
    },
    {
      "path": "/set-cookie",
      "status": 302,
      "location": "/cookie-check",
      "headers": {
        "Set-Cookie": "session=abc123; Path=/"
      }
    },
    {
      "path": "/cookie-check",
      "file": "pages/jsonld-cm.html",
      "note": "the server logs whether a Cookie header came"
    }
  ],
