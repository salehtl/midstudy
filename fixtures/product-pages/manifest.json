{
  "about": "Routes for evals/lib/pages_server.mjs and what POST /api/library/product must answer for each case (contract §2.11). dims are [w, d, h] in cm, checked within 0.6 cm (or 1 %), in order, as a prefix of dims_candidates. 'image0' must be in the first image's URL; 'images' lists substrings expected in order. {base} is the pages server's origin.",
  "routes": [
    { "path": "/products/oak-writing-desk", "file": "pages/jsonld-cm.html" },
    { "path": "/products/linen-armchair", "file": "pages/jsonld-graph-inch.html" },
    { "path": "/products/pebble-floor-cushion", "file": "pages/og-only.html" },
    { "path": "/products/moss-wool-rug", "file": "pages/shopify-variants.html" },
    { "path": "/products/moss-wool-rug.js", "file": "pages/shopify-variants.js", "type": "text/javascript; charset=utf-8" },
    { "path": "/product/walnut-sideboard/", "file": "pages/woo-store.html" },
    { "path": "/wp-json/wc/store/v1/products", "query": { "slug": "walnut-sideboard" }, "file": "pages/woo-store.json", "type": "application/json; charset=utf-8" },
    { "path": "/product/silk-carpet-rose/", "file": "pages/woo-sizes-unitless.html" },
    { "path": "/wp-json/wc/store/v1/products", "query": { "slug": "silk-carpet-rose" }, "file": "pages/woo-sizes-unitless.json", "type": "application/json; charset=utf-8" },
    { "path": "/products/tall-bookshelf-ash", "file": "pages/text-table.html" },
    { "path": "/products/harbor-sofa", "file": "pages/text-inches-letters.html" },
    { "path": "/p/5-shelf-bookcase-black/-/A-1234", "file": "pages/script-json.html" },
    { "path": "/products/round-side-table", "file": "pages/microdata.html" },
    { "path": "/products/teak-cabinet-prose", "file": "pages/prose-llm.html" },
    { "path": "/products/brass-lamp-injection", "file": "pages/injection.html" },
    { "path": "/products/cane-dining-chair", "file": "pages/picture-links.html" },
    { "path": "/no-product", "file": "pages/no-product.html" },
    { "path": "/blocked", "status": 403, "file": "pages/blocked.html" },
    { "path": "/busy", "status": 429, "file": "pages/blocked.html", "headers": { "Retry-After": "60" } },
    { "path": "/unavailable", "status": 503, "body": "<html><body>Service Unavailable</body></html>" },
    { "path": "/robot-check", "file": "pages/captcha.html" },
    { "path": "/missing", "status": 404, "body": "<html><body>Not found</body></html>" },
    { "path": "/picture.jpg", "generate": "jpeg", "type": "image/jpeg" },
    { "path": "/manual.pdf", "body": "%PDF-1.4 not really", "type": "application/pdf" },
    { "path": "/redirect-ok", "status": 302, "location": "/products/oak-writing-desk" },
    { "path": "/redirect-private", "status": 302, "location": "http://10.1.2.3/products/oak-writing-desk" },
    { "path": "/redirect-metadata", "status": 301, "location": "http://169.254.169.254/latest/meta-data/" },
    { "path": "/hops/{n}", "generate": "hops", "note": "302 to /hops/{n-1}; /hops/0 is the desk page. /hops/5 is allowed (5 redirects), /hops/6 is not." },
    { "path": "/slow", "generate": "slow", "note": "headers after 25 s" },
    { "path": "/trickle", "generate": "trickle", "note": "a valid start, then one byte a second for 60 s" },
    { "path": "/huge", "generate": "huge", "note": "the desk's JSON-LD, then 12 MB of filler" },
    { "path": "/gzip", "generate": "gzip", "note": "the desk page, Content-Encoding: gzip" },
    { "path": "/gzip-bomb", "generate": "gzip-bomb", "note": "the desk's JSON-LD, then 200 MB of spaces, gzipped (about 200 KB on the wire)" },
    { "path": "/set-cookie", "status": 302, "location": "/cookie-check", "headers": { "Set-Cookie": "session=abc123; Path=/" } },
    { "path": "/cookie-check", "file": "pages/jsonld-cm.html", "note": "the server logs whether a Cookie header came" }
  ],
  "cases": {
    "jsonld-cm": { "path": "/products/oak-writing-desk", "expect": { "status": 200, "name": "Oak Writing Desk", "category": "desk", "is_rug": false, "dims": [[120, 60, 75]], "source": "jsonld", "image0": "oak-desk-front.jpg", "image0_size": [2000, 1500], "llm": false } },
    "jsonld-graph-inch": { "path": "/products/linen-armchair", "expect": { "status": 200, "name": "Linen Armchair", "category": "armchair", "is_rug": false, "dims": [[80.0, 83.8, 78.1]], "unit": "in", "source": "jsonld", "image0": "linen-armchair.jpg", "llm": false } },
    "og-only": { "path": "/products/pebble-floor-cushion", "expect": { "status": 200, "name": "Pebble Floor Cushion", "is_rug": false, "dims": [], "no_dims": true, "image0": "pebble-cushion.jpg", "image0_size": [1200, 900], "llm": true, "warning": "size" } },
    "shopify-variants": { "path": "/products/moss-wool-rug", "expect": { "status": 200, "name": "Moss Wool Rug", "category": "rug", "is_rug": true, "dims": [[152.4, 243.8, 1.3], [243.8, 304.8, 1.3]], "variants": ["5' x 8'", "8' x 10'"], "unit": "ft", "layer": "shopify", "image0": "cdn.shopify.com/s/files/1/0001/moss-rug-top.jpg", "image0_https": true, "llm": false } },
    "woo-store": { "path": "/product/walnut-sideboard/", "expect": { "status": 200, "name": "Walnut Sideboard", "category": "sideboard", "is_rug": false, "dims": [[180, 45, 80]], "source": "woocommerce", "layer": "woocommerce", "note": "length", "image0": "sideboard-1.jpg", "llm": false } },
    "woo-sizes-unitless": { "path": "/product/silk-carpet-rose/", "expect": { "status": 200, "name": "Silk Carpet – Rose", "name_excludes": "Tabriz House", "category": "rug", "is_rug": true, "dims": [[200, 300, 1], [300, 400, 1]], "variants": ["2*3", "3*4"], "unit": "m", "unit_note": "m", "layer": "woocommerce", "image0": "rose-1.jpg", "llm": false } },
    "text-table": { "path": "/products/tall-bookshelf-ash", "expect": { "status": 200, "name": "Tall Bookshelf in Ash", "category": "bookcase", "is_rug": false, "dims": [[250, 36, 208]], "source": "text", "not_dims": [[210, 40, 30]], "image0": "tall-bookshelf-ash.jpg", "images": ["tall-bookshelf-ash.jpg", "/images/tall-bookshelf-ash-room.jpg"], "llm": false } },
    "text-inches-letters": { "path": "/products/harbor-sofa", "expect": { "status": 200, "name": "Harbor Sofa", "category": "sofa", "is_rug": false, "dims": [[256.5, 101.6, 77.5]], "unit": "in", "source": "text", "note": "length", "not_dims": [[223.5, 81.3, 43.8], [223.5, 61.0, 47.0]], "image0": "harbor-sofa-front.jpg", "llm": false } },
    "script-json": { "path": "/p/5-shelf-bookcase-black/-/A-1234", "expect": { "status": 200, "name": "5 Shelf Bookcase Black", "category": "bookcase", "is_rug": false, "dims": [[62.2, 29.4, 180.8]], "unit": "in", "source": "text", "image0": "GUEST_5shelf_black", "llm": false } },
    "microdata": { "path": "/products/round-side-table", "expect": { "status": 200, "name": "Round Side Table", "category": "side table", "is_rug": false, "dims": [[45, 45, 55]], "source": "microdata", "image0": "round-side-table.jpg", "llm": false } },
    "prose-llm": { "path": "/products/teak-cabinet-prose", "expect": { "status": 200, "name": "Teak Cabinet", "category": "cabinet", "is_rug": false, "dims": [[90, 40, 120]], "source": "llm", "llm": true, "mock": true, "cost_usd": 0 } },
    "injection": { "path": "/products/brass-lamp-injection", "expect": { "status": 200, "name": "Brass Floor Lamp", "name_excludes": "FAL", "category": "lamp", "is_rug": false, "dims": [], "no_dims": true, "llm": true, "warning": "language model" } },
    "picture-links": { "path": "/products/cane-dining-chair", "expect": { "status": 200, "name": "Cane Dining Chair", "category": "chair", "is_rug": false, "dims": [[48, 55, 82]], "source": "jsonld", "images": ["rattan.example/cdn/files/cane-chair.jpg", "{base}/cdn/files/cane-chair-back.jpg", "rattan.example/cdn/files/cane-chair-side.jpg", "rattan.example/cdn/files/cane-chair-detail.jpg"], "images_count": 4, "images_exclude": ["data:", "javascript:", "logo.svg"], "llm": false } },
    "no-product": { "path": "/no-product", "expect": { "status": 422, "error": "product" } },
    "blocked": { "path": "/blocked", "expect": { "status": 422, "blocked": true, "error": "This shop blocks automatic reading: paste the image link and size instead." } },
    "busy": { "path": "/busy", "expect": { "status": 422, "blocked": true, "error": "try again in a minute" } },
    "unavailable": { "path": "/unavailable", "expect": { "status": 422, "blocked": true, "error": "blocks automatic reading" } },
    "robot-check": { "path": "/robot-check", "expect": { "status": 422, "blocked": true, "error": "blocks automatic reading" } },
    "missing": { "path": "/missing", "expect": { "status": 422, "error": "404" } },
    "picture": { "path": "/picture.jpg", "expect": { "status": 422, "error": "Image link" } },
    "pdf": { "path": "/manual.pdf", "expect": { "status": 422, "error": "web page" } },
    "redirect-ok": { "path": "/redirect-ok", "expect": { "status": 200, "name": "Oak Writing Desk", "dims": [[120, 60, 75]], "url_ends": "/products/oak-writing-desk" } },
    "redirect-private": { "path": "/redirect-private", "expect": { "status": 400, "error": "private network", "max_s": 3 } },
    "redirect-metadata": { "path": "/redirect-metadata", "expect": { "status": 400, "error": "private network", "max_s": 3 } },
    "hops-5": { "path": "/hops/5", "expect": { "status": 200, "name": "Oak Writing Desk" } },
    "hops-6": { "path": "/hops/6", "expect": { "status": 422, "error": "redirects" } },
    "slow": { "path": "/slow", "expect": { "status": 422, "error": "20 s", "max_s": 24 } },
    "trickle": { "path": "/trickle", "expect": { "status": 422, "error": "20 s", "max_s": 24 } },
    "huge": { "path": "/huge", "expect": { "status": 200, "name": "Oak Writing Desk", "dims": [[120, 60, 75]], "warning": "10 MB" } },
    "gzip": { "path": "/gzip", "expect": { "status": 200, "name": "Oak Writing Desk", "dims": [[120, 60, 75]] } },
    "gzip-bomb": { "path": "/gzip-bomb", "expect": { "status": 200, "name": "Oak Writing Desk", "dims": [[120, 60, 75]], "warning": "10 MB", "max_s": 20 } },
    "cookie": { "path": "/set-cookie", "expect": { "status": 200, "name": "Oak Writing Desk", "no_cookie_sent": true } }
  },
  "refused_urls": [
    "http://10.0.0.1/products/x",
    "http://169.254.169.254/latest/meta-data/",
    "http://localhost:{pages_port}/products/oak-writing-desk",
    "http://[::1]:{pages_port}/products/oak-writing-desk",
    "http://127.0.0.1:{serve_port}/planner/",
    "http://0x7f000001:{pages_port}/products/oak-writing-desk",
    "http://[::ffff:127.0.0.1]:{pages_port}/products/oak-writing-desk",
    "http://100.100.100.100/x",
    "ftp://example.com/x",
    "file:///etc/passwd",
    "javascript:alert(1)",
    "not a link"
  ]
}
