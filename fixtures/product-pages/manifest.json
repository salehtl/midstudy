{
  "about": "Routes for evals/lib/pages_server.mjs and what POST /api/library/product must answer for each case (contract §2.11). dims are [w, d, h] in cm, checked within 0.6 cm (or 1 %), in order, as a prefix of dims_candidates. 'image0' must be in the first image's URL; 'images' lists substrings expected in order. {base} is the pages server's origin.",
  "routes": [
    {
      "path": "/products/oak-writing-desk",
      "file": "pages/jsonld-cm.html"
    },
    {
      "path": "/products/linen-armchair",
      "file": "pages/jsonld-graph-inch.html"
    },
    {
      "path": "/products/pebble-floor-cushion",
      "file": "pages/og-only.html"
    },
    {
      "path": "/products/moss-wool-rug",
      "file": "pages/shopify-variants.html"
    },
    {
      "path": "/products/moss-wool-rug.js",
      "file": "pages/shopify-variants.js",
      "type": "text/javascript; charset=utf-8"
    },
    {
      "path": "/product/walnut-sideboard/",
      "file": "pages/woo-store.html"
    },
    {
      "path": "/wp-json/wc/store/v1/products",
      "query": {
        "slug": "walnut-sideboard"
      },
      "file": "pages/woo-store.json",
      "type": "application/json; charset=utf-8"
    },
    {
      "path": "/product/silk-carpet-rose/",
      "file": "pages/woo-sizes-unitless.html"
    },
    {
      "path": "/wp-json/wc/store/v1/products",
      "query": {
        "slug": "silk-carpet-rose"
      },
      "file": "pages/woo-sizes-unitless.json",
      "type": "application/json; charset=utf-8"
    },
    {
      "path": "/products/tall-bookshelf-ash",
      "file": "pages/text-table.html"
    },
    {
      "path": "/products/harbor-sofa",
      "file": "pages/text-inches-letters.html"
    },
    {
      "path": "/p/5-shelf-bookcase-black/-/A-1234",
      "file": "pages/script-json.html"
    },
    {
      "path": "/products/round-side-table",
      "file": "pages/microdata.html"
    },
    {
      "path": "/products/teak-cabinet-prose",
      "file": "pages/prose-llm.html"
    },
    {
      "path": "/products/brass-lamp-injection",
      "file": "pages/injection.html"
    },
    {
      "path": "/products/cane-dining-chair",
      "file": "pages/picture-links.html"
    },
    {
      "path": "/products/dune-flatweave-rug",
      "file": "pages/ui-rug.html"
    },
    {
      "path": "/products/morris-reading-chair",
      "file": "pages/ui-chair.html"
    },
    {
      "prefix": "/media/",
      "file": "../fal/sam-3-3d-objects/input.jpg",
      "type": "image/jpeg",
      "note": "any picture under /media/ is the committed SAM 3D fixture photo (a real JPEG), so a Make from these pages runs the real from-URL add offline"
    },
    {
      "path": "/line/{n}",
      "generate": "line",
      "lines": [
        {
          "text": "Dimensions: 200 x 90 x 85 cm (W x D x H)"
        },
        {
          "text": "W x D x H: 84 x 38 x 34 in"
        },
        {
          "text": "85 x 200 x 90 cm (H x W x D)"
        },
        {
          "text": "Dimensions (HxWxD): 180 x 80 x 40 cm"
        },
        {
          "text": "Product Dimensions: 78.7\"L x 35.4\"W x 33.5\"H",
          "title": "Linen Sofa"
        },
        {
          "text": "Overall 16” W x 13” L x 7” H"
        },
        {
          "text": "Dimensions: 200W x 90D x 85H cm"
        },
        {
          "text": "Overall Product Dimensions: 34 H x 84 W x 38 D in"
        },
        {
          "text": "Dimensions: 18\" Dia x 22\" H",
          "title": "Round Side Table"
        },
        {
          "text": "Size: 200 (W) x 90 (D) x 85 (H) cm"
        },
        {
          "text": "Width 200cm Depth 90cm Height 85cm"
        },
        {
          "text": "Maße: B 120 x T 60 x H 75 cm"
        },
        {
          "text": "Breite: 120 cm, Tiefe: 60 cm, Höhe: 75 cm"
        },
        {
          "text": "Dimensions: W 180–220 cm x D 90 cm x H 75 cm",
          "title": "Extending Table"
        },
        {
          "text": "Bed size: L 210 x W 170 x H 95 cm",
          "title": "Oak Bed Frame"
        },
        {
          "text": "Item code 123456789012345678 · Dimensions: 120 x 60 x 75 cm"
        }
